{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightListen",
  "version": "0.1.2",
  "identifier": "com.qt.lightlisten",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻听",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost qtres: http://qtres.localhost https://qtres.localhost data: blob:; media-src 'self' asset: http://asset.localhost qtres: http://qtres.localhost https://qtres.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost qtres: http://qtres.localhost https://qtres.localhost blob:; font-src 'self' data:"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
