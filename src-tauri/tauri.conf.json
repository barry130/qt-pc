{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuietMusic",
  "version": "1.1.3",
  "identifier": "com.qt.quietmusic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "轻听",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --js-flags=--max-old-space-size=768 --disk-cache-size=52428800",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost qtres: http://qtres.localhost https://qtres.localhost data: blob:; media-src 'self' asset: http://asset.localhost qtres: http://qtres.localhost https://qtres.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost qtres: http://qtres.localhost https://qtres.localhost blob:; font-src 'self' data:"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["mp3", "flac", "wav", "ogg", "m4a"],
        "name": "QuietMusic.AudioFile",
        "description": "轻听音频文件",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
